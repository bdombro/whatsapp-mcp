# whatsapp-client tasks
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# List recipes
_:
    @just --list

# Run unit tests
test:
    go test ./...

# Build binary
build:
    mkdir -p dist
    go build -ldflags "-X 'main.BuildTime=$(date -u '+%Y-%m-%d %H:%M:%S UTC')' -X 'main.BuildVersion=$(git describe --tags --always --dirty 2>/dev/null || echo dev)'" -o dist/whatsapp-client .

# Clean build artifacts
clean:
    rm -rf dist
